{
  "name": "golinks-console",
  "version": "1.0.0",
  "private": true,
  "description": "Internal go-links shortcut directory",
  "author": "Sahithi Periketi",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.ui.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.ui.json && tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.2.1",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
